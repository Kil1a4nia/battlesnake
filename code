// ---- Main Move Function ----

export function move(gameState: GameState): MoveResponse {
  const scores: Record<string, number> = {};
  const enemies = gameState.board.snakes.filter(s => s.id !== gameState.you.id);

  for (const dir of Object.keys(DIRS)) {
    scores[dir] = scoreMove(dir, gameState);

    // Add minimax lookahead score × 0.6
    const d = DIRS[dir];
    const next: Coord = { x: gameState.you.head.x + d.dx, y: gameState.you.head.y + d.dy };
    if (inBounds(next, gameState.board)) {
      const newBody = [next, ...gameState.you.body.slice(0, -1)];
      const newSnake: Battlesnake = {
        ...gameState.you,
        head: next,
        body: newBody,
        health: gameState.you.health - 1,
      };
      try {
        const mmScore = minimax(
          newSnake,
          enemies.slice(0, 2), // limit for performance
          gameState.board,
          6,
          -Infinity,
          Infinity,
          false,
          gameState.turn + 1
        );
        scores[dir] += mmScore * 0.6;
      } catch {
        // Ignore minimax errors
      }
    }
  }

  const sorted = Object.entries(scores).sort((a, b) => b[1] - a[1]);
  let best = sorted[0][0];
  let bestScore = sorted[0][1];

  // ---- Survival Fallback: 6-step lookahead ----
  // When the best scoring direction is still a fatal move (score <= -1e8),
  // all "normal" directions are blocked. Switch to survival mode:
  // simulate up to 6 steps for each safe (non-instant-death) direction,
  // pick whichever keeps us alive the longest.
  if (bestScore <= -1e8) {
    const survivalSteps: Record<string, number> = {};
    const { you: fallbackYou, board: fallbackBoard } = gameState;
    const fallbackObs = buildObstacles(gameState, fallbackYou.head);

    for (const [dName, dv] of Object.entries(DIRS)) {
      const firstStep: Coord = {
        x: fallbackYou.head.x + dv.dx,
        y: fallbackYou.head.y + dv.dy,
      };
      // Skip instantly fatal moves (out of bounds or solid obstacle)
      if (!inBounds(firstStep, fallbackBoard) || fallbackObs.has(key(firstStep))) {
        survivalSteps[dName] = 0;
        continue;
      }

      // BFS-simulate up to 6 steps greedily (always pick direction with most space)
      let simHead = firstStep;
      // Build obstacles after first step
      let simObs = buildObstaclesAfterMove(gameState, firstStep);
      let steps = 1;

      for (; steps < 6; steps++) {
        // Prune: check if simHead itself has any valid neighbor before doing floodFill
        let hasAnyExit = false;
        for (const sdv of Object.values(DIRS)) {
          const nb: Coord = { x: simHead.x + sdv.dx, y: simHead.y + sdv.dy };
          if (inBounds(nb, fallbackBoard) && !simObs.has(key(nb))) {
            hasAnyExit = true;
            break;
          }
        }
        // No exits at all — dead end, stop immediately
        if (!hasAnyExit) break;

        let bestSpace = -1;
        let bestNext: Coord | null = null;
        for (const sdv of Object.values(DIRS)) {
          const nb: Coord = { x: simHead.x + sdv.dx, y: simHead.y + sdv.dy };
          if (inBounds(nb, fallbackBoard) && !simObs.has(key(nb))) {
            const sp = floodFill(nb, simObs, fallbackBoard);
            if (sp > bestSpace) {
              bestSpace = sp;
              bestNext = nb;
            }
          }
        }
        // bestSpace === 0 means every reachable neighbor leads into a 0-cell pocket
        if (bestNext === null || bestSpace === 0) break;
        // Advance: add current simHead to obstacles (body moves forward)
        simObs = new Set(simObs);
        simObs.add(key(simHead));
        simHead = bestNext;
      }

      survivalSteps[dName] = steps;
    }

    const survivalSorted = Object.entries(survivalSteps).sort((a, b) => b[1] - a[1]);
    best = survivalSorted[0][0];
    bestScore = scores[best];
    console.log(`[SURVIVAL FALLBACK] T${gameState.turn}: survivalSteps=${JSON.stringify(survivalSteps)} => ${best}`);
  }

  // ---- Build shout debug info ----
  const { you, board, turn } = gameState;
  const obstacles = buildObstacles(gameState, you.head);
  const mySpace = floodFill(you.head, obstacles, board);

  // Nearest good food distance
  const goodFoods = board.food.filter(isGoodFood);
  let nearestFoodDist = 999;
  let nearestFoodType = '-';
  for (const f of goodFoods) {
    const dist = bfsDistance(you.head, f, obstacles, board);
    if (dist < nearestFoodDist) {
      nearestFoodDist = dist;
      nearestFoodType = f.value === FoodType.Peach ? '🍑' : '🥟';
    }
  }

  // Enemy info: closest enemy
  const aliveEnemies = board.snakes.filter(s => s.id !== you.id);
  let closestEnemyDist = 999;
  let closestEnemyLen = 0;
  let closestEnemyRelSize = '?';
  for (const e of aliveEnemies) {
    const d = manhattan(you.head, e.head);
    if (d < closestEnemyDist) {
      closestEnemyDist = d;
      closestEnemyLen = e.length;
      closestEnemyRelSize = you.length > e.length + 2 ? '↑' : you.length < e.length - 2 ? '↓' : '='
    }
  }

  // Score ranking: show direction scores compactly
  const scoreStr = sorted
    .map(([d, s]) => `${d[0].toUpperCase()}:${Math.round(s)}`)
    .join(' ');

  const shout = [
    `T${turn}`,
    `HP:${you.health}`,
    `L:${you.length}`,
    `SP:${mySpace}`,
    `F${nearestFoodType}:${nearestFoodDist === 999 ? '-' : nearestFoodDist}`,
    aliveEnemies.length > 0 ? `E${closestEnemyRelSize}:${closestEnemyDist}(${closestEnemyLen})` : 'NoE',
    `>${best.toUpperCase()}(${Math.round(bestScore)})`,
    scoreStr,
  ].join(' | ');

  console.log(`MOVE ${turn}:`, scores, `=> ${best}`);
  return { move: best, shout };
}
